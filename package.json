{
  "name": "agent-office",
  "private": true,
  "version": "1.0.0",
  "description": "A live office of your Claude Code sessions and subagents: the bridge, the page, and a settings-hooks installer.",
  "type": "module",
  "bin": {
    "agent-office": "agent-office/server/cli.mjs"
  },
  "files": [
    "agent-office/server",
    "agent-office/fallback",
    "agent-office/.claude-plugin",
    "agent-office/hooks",
    "agent-office/icon.png",
    "agent-office/skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node agent-office/server/cli.mjs",
    "demo": "node agent-office/server/cli.mjs demo",
    "test": "node --test agent-office/server/*.test.mjs scripts/*.test.mjs visualizer/src/*.test.mjs",
    "build": "npm --prefix visualizer run build",
    "build:demo-site": "node scripts/build-demo-site.mjs",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tharun-se95/ModsArena.git"
  },
  "homepage": "https://github.com/tharun-se95/ModsArena#agent-office",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
